{
  "manifest_version": 3,
  "name": "Auto Add to Cart",
  "version": "1.1",
  "description": "Automatically selects a product and adds it to cart to try and order it.",
  "permissions": ["scripting", "activeTab", "tabs", "storage", "downloads", "notifications"],
  "host_permissions": [
    "https://www.kamera-express.nl/*",
    "https://www.kamera-express.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "start-auto-cart": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q"
      },
      "description": "Run the Auto Cart Script"
    }
  }
}
